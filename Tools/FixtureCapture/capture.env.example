# Eros fixture capture: credentials and settings, read from environment variables only.
#
# Copy this file to capture.env next to it and point each value at your own 1Password item, then run the
# capture tool under `op run --env-file=Tools/FixtureCapture/capture.env -- <command>` so the values are injected
# into the environment and never written to disk. capture.env is git-ignored: never commit it, and never put real
# values in this example. Values are 1Password secret references of the form op://<vault>/<item>/<field>.
#
# Unset or empty variables are treated as missing. Errors and logs name variables, never their values.

# Required: login cookie ipb_member_id.
EH_IPB_MEMBER_ID=op://<vault>/<item>/ipb_member_id
# Required: login cookie ipb_pass_hash.
EH_IPB_PASS_HASH=op://<vault>/<item>/ipb_pass_hash
# Required when capturing ExHentai, optional otherwise: cookie igneous. "mystery" is rejected.
EH_IGNEOUS=op://<vault>/<item>/igneous
# Optional: cookie sk.
EH_SK=op://<vault>/<item>/sk
# Optional: cookie hath_perks.
EH_HATH_PERKS=op://<vault>/<item>/hath_perks
# Optional: cookie star.
EH_STAR=op://<vault>/<item>/star
# Optional: cookie yay.
EH_YAY=op://<vault>/<item>/yay
# Optional: cookie iq.
EH_IQ=op://<vault>/<item>/iq
# Optional: cookie cf_clearance. Requires EH_USER_AGENT: Cloudflare binds the clearance to the browser's user agent.
EH_CF_CLEARANCE=op://<vault>/<item>/cf_clearance
# Optional: cookie cf_duid.
EH_CF_DUID=op://<vault>/<item>/cf_duid
# Optional: cookie sp, the site profile to capture with.
EH_SP=op://<vault>/<item>/sp
# Optional (required with EH_CF_CLEARANCE): the exact user agent of the browser the cookies came from.
# Defaults to the app's desktop Chrome user agent.
EH_USER_AGENT=op://<vault>/<item>/user_agent
# Required: account username. Not sent anywhere; only used to remove it from fixtures.
# The plan has no forum profile page, so it is not discovered automatically.
EH_USERNAME=op://<vault>/<item>/username
